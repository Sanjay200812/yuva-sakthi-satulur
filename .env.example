# ==============================================================================
# Yuva Shakti Youth Satulur - Lucky Draw Portal (.env.example)
# Production & Local Configuration Specification
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000
APP_URL=https://yuva-shakti-youth-satulur-lucky-draw.vercel.app

# Secret Session Key for Signed Admin Cookies / CSRF Protection
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_secret

# ------------------------------------------------------------------------------
# Database Persistence (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL Connection String (Direct connection or Supabase Transaction Pooler)
# e.g., postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# VyaparGateway Payment Integration (vyapargateway.com)
# ------------------------------------------------------------------------------
# Provider: 'vyapar_gateway' or 'mock'
PAYMENT_PROVIDER=vyapar_gateway
# Mode: 'test' or 'live' (Production MUST use 'live')
PAYMENT_MODE=live
VYAPAR_GATEWAY_BASE_URL=https://vyapargateway.com/api/v1/
VYAPAR_GATEWAY_API_KEY=
VYAPAR_GATEWAY_WEBHOOK_SECRET=
VYAPAR_GATEWAY_MERCHANT_ID=

# ------------------------------------------------------------------------------
# Event Schedule & Legal Approval Go-Live Gate
# ------------------------------------------------------------------------------
EVENT_NAME="Yuva Shakti Youth Satulur Lucky Draw"
EVENT_ORGANIZER="Yuva Shakti Youth, Satulur"
EVENT_PRIZE="20 KG Laddu"
EVENT_VENUE="Satulur Center, Guntur District, Andhra Pradesh"
EVENT_HELPLINE="+91 95748 76369"
EVENT_DRAW_AT=2026-10-19T18:30:00+05:30
EVENT_TIMEZONE=Asia/Kolkata
EVENT_COUPON_PRICE_PAISE=5000
EVENT_COUPON_PREFIX=YSYS
EVENT_MAX_COUPONS_PER_BOOKING=20

# Go-Live Controls (Must all be true for live payments to process)
BOOKING_OPEN=true
PAYMENTS_ENABLED=false
LEGAL_APPROVAL_CONFIRMED=false
LOTTERY_LICENCE_NUMBER=
LOTTERY_LICENCE_DATE=

# ------------------------------------------------------------------------------
# Initial Administrator Bootstrap (scripts/seed-admin.ts)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yuvashakti.org
ADMIN_PASSWORD=YuvaShakti@Admin2026
